    )


# ============================================================
# CALLBACK HANDLER
# ============================================================

async def button_handler(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE
):

    query = update.callback_query

    # Always answer first, otherwise the button
    # keeps showing the loading circle.
    await query.answer()

    data = query.data

    # --------------------------------------------------------
    # SERVICES
    # --------------------------------------------------------

    if data == "services":

        await safe_edit(
            query,
            "🛠️ Available Services",
            services_keyboard()
        )

    # --------------------------------------------------------
    # BOOK SERVICE
    # (this branch was missing in the original code,
    #  so the button did nothing)
    # --------------------------------------------------------

    elif data == "book":

        keyboard = [
            [
                InlineKeyboardButton(
                    "⬅️ Back",
                    callback_data="services"
                )
            ]
        ]

        await safe_edit(
            query,
            "📅 Booking\n\n"
            "Your booking request has been received.\n"
            "Our team will contact you shortly.",
            InlineKeyboardMarkup(keyboard)
        )

    # --------------------------------------------------------
    # DOCUMENTS
    # --------------------------------------------------------

    elif data == "documents":

        await safe_edit(
            query,
            "📁 Available Documents\n\n"
            "Select a file to download:",
            documents_keyboard()
        )

    # --------------------------------------------------------
    # FILE DOWNLOAD
    # --------------------------------------------------------

    elif data in DOCUMENTS:

        await send_file(query, data)

    # --------------------------------------------------------
    # BACK TO MAIN MENU
    # --------------------------------------------------------

    elif data == "back":

        await safe_edit(
            query,
            "🏠 Main Menu",
            main_menu_keyboard()
        )

    # --------------------------------------------------------
    # UNKNOWN BUTTON
    # --------------------------------------------------------

    else:

        await safe_edit(
            query,
            "❌ Unknown option.\n\n"
            "Please use /start to begin again.",
            main_menu_keyboard()
        )


# ============================================================
# ERROR HANDLER
# ============================================================

async def error_handler(
    update: object,
    context: ContextTypes.DEFAULT_TYPE
):

    print(f"ERROR: {context.error}")


# ============================================================
# MAIN
# ============================================================

def main():

    if not TOKEN or TOKEN == "YOUR_BOT_TOKEN":

        print(
            "ERROR: Bot token is not set. "
            "Please add a valid token."
        )

        return

    # Make sure the files folder exists
    os.makedirs(FILES_DIR, exist_ok=True)

    application = (
        Application.builder()
        .token(TOKEN)
        .build()
    )

    # /start command
    application.add_handler(
        CommandHandler("start", start)
    )

    # Inline button handler
    application.add_handler(
        CallbackQueryHandler(button_handler)
    )

    # Error handler
    application.add_error_handler(error_handler)

    print("🤖 Bot is running...")

    application.run_polling()


# ============================================================
# RUN PROGRAM
# ============================================================

if __name__ == "__main__":
    main()
