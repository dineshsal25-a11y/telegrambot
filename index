# ============================================================
# SAFE MESSAGE EDIT
# ============================================================

async def safe_edit(query, text, reply_markup=None):
    """
    Edits the message and ignores the
    "Message is not modified" error that Telegram raises
    when the same menu is opened twice.
    """

    try:

        await query.edit_message_text(
            text,
            reply_markup=reply_markup
        )

    except BadRequest as error:

        if "message is not modified" in str(error).lower():
            return

        raise


# ============================================================
# SEND A FILE
# ============================================================

async def send_file(query, key):

    file_name, caption, file_type = DOCUMENTS[key]

    file_path = FILES_DIR / file_name

    # Check the file BEFORE sending it.
    # Without this check Telegram treats the missing path
    # as a file_id and raises "wrong file identifier".
    if not file_path.is_file():

        await query.message.reply_text(
            "❌ File not found on the server.\n\n"
            f"Expected location:\n{file_path}\n\n"
            "Please contact the administrator."
        )
        return

    try:

        with file_path.open("rb") as file_handle:

            if file_type == "photo":

                await query.message.reply_photo(
                    photo=file_handle,
                    caption=caption
                )

            else:

                await query.message.reply_document(
                    document=file_handle,
                    filename=file_name,
                    caption=caption
                )

    except Exception as error:

        print(f"ERROR while sending {file_name}: {error}")

        await query.message.reply_text(
            "❌ Sorry, the file could not be sent.\n\n"
            "Please try again later."
        )


